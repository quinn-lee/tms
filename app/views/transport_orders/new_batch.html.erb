<div id="orderForm" class="card-new" style="margin-bottom: 2rem;">
  <div class="card-header">
      <div class="card-title">Delivery Orders Batch Upload</div>
  </div>
  <div class="card-body">
    <%= form_with(url: uploaded_transport_orders_path, method: "post") do |f|%>
      <% if @errors.present? %>
        <ul class="list-group">
          <li class="list-group-item active">Order Uploaded Failed</li>
          <% @errors.each do |msg| %>
            <li class="list-group-item list-group-item-danger"><%= msg %></li>
          <% end -%>
        </ul>
      <% end -%>
      <div class="form-section" style="margin-bottom: 2rem;    margin-top: 2.5rem;">
        <div class="form-title">
            <i class="fas fa-file" style="margin-right: 0.5rem;"></i>Step1: Download Template
        </div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
          <a title="Template" class="btn-icon" href="<%=template_transport_orders_path%>" target="_blank"><i class="fas fa-file-arrow-down">Template</i></a>
        </div>
      
      
      </div>
      <div class="form-section" style="margin-bottom: 2rem;    margin-top: 2.5rem;">
        <div class="form-title">
            <i class="fas fa-file-import" style="margin-right: 0.5rem;"></i>Upload Excel File
        </div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
          <div class="form-group">
              <label class="form-label">Warehouse*</label>
              <%= f.select :branch_id, Branch.where(status: "in_service").map{|branch| [branch.branch_code, branch.id]}, {required: true}, {class: 'form-select'} %>
          </div>
          <div class="form-group">
              <label class="form-label">Customer*</label>
              <%= f.select :user_id, User.where(staff_grade: "customer").map{|user| [user.nickname, user.id]}, {required: true}, {class: 'form-select'} %>
            </div>
          <div class="form-group">
              <label class="form-label">File*</label>
              <%= f.file_field :file, class: "form-control", style: "line-height: 2.2; margin-bottom: 20px;", required: true%>
          </div>
        </div>
      
      </div>
      <div style="display: flex; justify-content: flex-end; gap: 1rem;">
          <button type="submit" class="btn btn-primary">Upload</button>
      </div>
    <% end %>
  </div>
</div>
