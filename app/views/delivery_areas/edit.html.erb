<div id="userForm" class="card-new" style="margin-bottom: 2rem;">
  <div class="card-header">
      <div class="card-title">Edit Delivery Area</div>
  </div>
  <div class="card-body">
    <%= form_with(model: @area, method: "put") do |f|%>
      <% unless f.object.errors.empty? %>
        <ul class="list-group">
          <li class="list-group-item active">Branch Update Failed</li>
          <% f.object.errors.full_messages.each do |msg| %>
            <li class="list-group-item list-group-item-danger"><%= msg %></li>
          <% end -%>
        </ul>
      <% end -%>
      <div class="form-section" style="margin-bottom: 2rem;    margin-top: 2.5rem;">
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
          <div class="form-group">
              <label class="form-label">Area Code*</label>
              <%= f.text_field :area_code, class: "form-input", placeholder: "", required: true %>
          </div>
          <div class="form-group">
              <label class="form-label">Area Name*</label>
              <%= f.text_field :area_name, class: "form-input", placeholder: "", required: true %>
          </div>
          <div class="form-group">
              <label class="form-label">Warehouse*</label>
              <%= f.select :branch_id, Branch.where(status: "in_service").map{|branch| [branch.branch_code, branch.id]}, {required: true}, {class: 'form-select'} %>
          </div>
        </div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
          <div class="form-group">
              <label class="form-label">Dispatch Frequency</label>
              <%= f.select :dispatch_frequency, ['','每日1趟', '隔日', '每周2次', '按需凑单'], {required: false}, {class: 'form-select'} %>
          </div>
          <div class="form-group">
              <label class="form-label">Min Order Num</label>
              <%= f.number_field :min_order_num, class: "form-input", placeholder: ""%>
          </div>
          <div class="form-group">
              <label class="form-label">Max Volume</label>
              <%= f.number_field :truck_max_volume, class: "form-input", placeholder: "", step: '0.01'%>
          </div>
        </div>
        <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
          <div class="form-group">
              <label class="form-label">Max Weight</label>
              <%= f.number_field :truck_max_weight_t, class: "form-input", placeholder: "", step: '0.01'%>
          </div>
          <div class="form-group" style="margin-bottom: 1.5rem;">
            <label class="form-label">Postcodes*(Separate With ,)</label>
            <%= f.text_area :postcodes, class: "form-input", placeholder: "Separate with commas", rows: 4, required: true%>
          </div>
          <div class="form-group">
              <label class="form-label">Status*</label>
              <%= f.select :status, ['normal', 'out_of_service'], {required: true}, {class: 'form-select'} %>
          </div>
        </div>
      </div>
      
      <div style="display: flex; justify-content: flex-end; gap: 1rem;">
          <button type="submit" class="btn btn-primary">Submit</button>
      </div>
    <% end %>
  </div>
</div>