<div class="vehicle-list" style="margin-bottom: 2rem;">
  <div class="list-header">
    <div class="list-title">Order Routes</div>
    <div class="card-body">
      <%= form_with(method: "get") do |f|%>
        <div class="form-section" style="margin-bottom: 2rem;    margin-top: 2.5rem;">
          <div class="form-row" style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
            <div class="form-group">
                <label class="form-label">Customer</label>
                <%= f.select :user_id, options_for_select(User.where(staff_grade: "customer").map{|user| [user.nickname, user.id]}.unshift(['','']), params[:user_id]), {}, {class: 'form-select'} %>
            </div>
            <div class="form-group">
              <label class="form-label">ETA</label>
              <%= f.text_field :expected_arrival_time, value: params[:expected_arrival_time], class: "form-input flatpickr-date" %>
            </div>
            <div class="form-group">
              <label class="form-label">City</label>
              <%= f.text_field :city, value: params[:city], class: "form-input" %>
            </div>
            <div class="form-group">
              <label class="form-label">PostCode</label>
              <%= f.text_field :postcode, value: params[:postcode], class: "form-input" %>
            </div>
            <div class="form-group" style="text-align: left;">
              <button type="submit" class="btn btn-primary" style="margin-top: 33px;height: 50px;">Search</button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <%= form_with(url: new_transport_task_path, method: "get") do |f|%>
  <table>
    <thead>
      <tr>
        <th><%= check_box_tag 'selectFlag', '', false, onclick:'checkAll(this)' %></th>
        <th>From</th>
        <th>To</th>
        <th>Order NO.</th>
        <th>Customer</th>
        <th>Mileage(KM)</th>
        <th>Duration(min)</th>
        <th>ETD</th>
        <th>ETA</th>
        <th>Status</th>
        <!--<th>Actions</th>-->
      </tr>
    </thead>
    <tbody>
      <% @c_routes.each do |routes| %>
        <% routes.each_with_index do |route, index| %>
        <tr>
          <% if index == 0 %>
          <td rowspan="2"><input type="checkbox" name="ids[]" value="<%=routes[0].id%>,,,<%=routes[1].id%>"></td>
          <% end %>
          <td><%=route.first_location%></td>
          <td><%=route.end_location%></td>
          <td><%=route.order.order_no%></td>
          <td><%=route.order.user.user_name || route.order.user.nickname%></td>
          <td><%=route.planned_mileage%></td>
          <td><%=route.planned_duration%></td>
          <td><%=route.expected_departure_time&.strftime("%F")%><br/>
          <%=route.expected_departure_time&.strftime("%T")%></td>
          <td><%=route.expected_arrival_time&.strftime("%F")%><br/>
          <%=route.expected_arrival_time&.strftime("%T")%></td>
          <td><%=route.status%></td>
          <!--<td>
              
          </td>-->
        </tr>
        <% end %>
      <% end %>
      <% @routes.each_with_index do |route, index|%>
      <tr>
        <td><input type="checkbox" name="ids[]" value="<%=route.id%>"></td>
        <td><%=route.first_location%></td>
        <td><%=route.end_location%></td>
        <td><%=route.order.order_no%></td>
        <td><%=route.order.user.user_name || route.order.user.nickname%></td>
        <td><%=route.planned_mileage%></td>
        <td><%=route.planned_duration%></td>
        <td><%=route.expected_departure_time&.strftime("%F")%><br/>
          <%=route.expected_departure_time&.strftime("%T")%>
        </td>
        <td><%=route.expected_arrival_time&.strftime("%F")%><br/>
          <%=route.expected_arrival_time&.strftime("%T")%></td>
        <td><%=route.status%></td>
        <!--<td>
            
        </td>-->
      </tr>
      <% end %>
    </tbody>
  </table>
  <div style="display: flex; justify-content: flex-start; gap: 1rem;     margin-top: 1rem; margin-left: 1rem; margin-bottom: 1rem;">
      <button type="submit" class="btn btn-primary">Create Task</button>
  </div>
  <% end %>
  
</div>
<script type="text/javascript">
  flatpickr(".flatpickr-date", {
    enableTime: false,        // 启用时间选择
    dateFormat: "Y/m/d", // 设置所需的日期时间格式
    minDate: "today"
  });
</script>
<script type="text/javascript">
  function checkAll(object)
  {
     var order_id = document.getElementsByName("ids[]");
     var length = order_id.length;
     var checked = object.checked;
     //alert(checked)
     for (var i = 0; i < length; i++)
     {
       order_id[i].checked=checked;
     }
  }
</script>
